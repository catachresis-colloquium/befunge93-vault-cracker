# SPDX-License-Identifier: MPL-2.0
# RSR-compliant .gitignore for befunge93-vault-cracker
# Note: `build/just/` contains tracked provisioning scripts; never ignore `build/`.

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Generated Build & FFI Outputs
/dist/
/out/
/target/
/_build/
/build-idris/
/.eval/
/ffi/zig/zig-out/
/ffi/zig/.zig-cache/

# Dependencies & Caches
/node_modules/
/vendor/
/deps/
/.cache/

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage & Logs
/coverage/
*.log
/logs/

# Temp & Crash Capture
/tmp/
*.tmp
*.bak
ai-cli-crash-capture/
